# ─────────────────────────────────────────────
# OnlineKirana — storefront environment (EXAMPLE)
#
# Copy this file to `.env` and fill in real values:
#     cp client/.env.example client/.env
#
# `.env` is gitignored and must never be committed.
#
# Every variable below is REQUIRED. There is no localhost fallback in the code —
# a build with a missing variable throws immediately, so you cannot accidentally
# ship a site whose links point at your own machine.
#
# Vite only exposes variables prefixed with `VITE_` to the browser. Anything
# without that prefix stays secret and will read as `undefined`.
#
# On Vercel: Project → Settings → Environment Variables. These are read at BUILD
# time, so redeploy after changing them.
#
# Real files: `.env.development` (npm run dev) and `.env.production`
# (npm run build). This example is the shape both of them follow.
# ─────────────────────────────────────────────

# ── Local development ──
#   terminal 1 →  server:   npm --prefix ../server run dev    (:5000)
#   terminal 2 →  client:   npm run dev                      (:5173)
#   terminal 3 →  partners: npm --prefix ../partners run dev  (:5174)

# Base URL of the backend API, no trailing slash.
VITE_API_URL=http://localhost:5000

# The partner portal (merchants, riders, operations). The storefront header and
# footer link here, so a wrong value sends shoppers to a dead page.
VITE_PARTNERS_URL=http://localhost:5174

# This app's OWN public address. Required by src/lib/apps.js at import time —
# omit it and the whole app throws while loading, giving a blank white screen.
VITE_STOREFRONT_URL=http://localhost:5173

# ── Production (Vercel) — replace all three, then redeploy ──
#
#   VITE_API_URL=https://<your-api-host>.onrender.com
#   VITE_PARTNERS_URL=https://<partners-domain>
#
# Use whatever domains you control. The auto-assigned *.vercel.app URLs work as
# values, but they change if the project is renamed — a custom domain is safer
# for the cross-app links, because one rename then cannot break the other app.
