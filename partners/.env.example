# ─────────────────────────────────────────────
# OnlineKirana — partner portal environment (EXAMPLE)
#
# Copy to `.env` and fill in real values:
#     cp partners/.env.example partners/.env
#
# `.env` is gitignored and must never be committed.
#
# Both variables below are REQUIRED — the code throws on a missing value rather
# than falling back to localhost, so a half-configured build fails fast instead
# of shipping links to the developer's own machine.
#
# Vite only exposes variables prefixed with `VITE_` to the browser.
#
# On Vercel: Project → Settings → Environment Variables. Read at BUILD time, so
# redeploy after changing them.
# ─────────────────────────────────────────────

# ── Local development ──
#   terminal 1 →  server:   npm --prefix ../server run dev    (:5000)
#   terminal 2 →  partners: npm run dev                      (:5174)

# Base URL of the backend API, no trailing slash.
VITE_API_URL=http://localhost:5000

# The public storefront. The portal header, footer and sign-in page all link
# across to it, so this must be the shopper-facing deployment.
VITE_STOREFRONT_URL=http://localhost:5173

# ── Production (Vercel) — replace both, then redeploy ──
#
#   VITE_API_URL=https://<your-api-host>.onrender.com
#   VITE_STOREFRONT_URL=https://<storefront-domain>
#
# This must be the SAME value the storefront project lists as its own domain,
# or the two apps will link to two different copies of the shop.
