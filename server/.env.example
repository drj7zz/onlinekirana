# ─────────────────────────────────────────────────────────────
# OnlineKirana — server environment (EXAMPLE)
# Copy this file to `.env` and fill in your own values:
#     cp server/.env.example server/.env
# The real `server/.env` is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# Port the Express API listens on
PORT=5000

# MongoDB connection string.
#   Local:  mongodb://127.0.0.1:27017/onlinekirana
#   Atlas:  mongodb+srv://<user>:<password>@<cluster-host>/onlinekirana?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/onlinekirana

# (Informational only — the full credentials live in MONGO_URI above.)
# Only needed if you build the URI from parts.
DB_USER=
DB_PASS=

# Secret used to sign/verify JWTs. Use a long, random string in production.
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Allowed CORS origin (your frontend URL)
CLIENT_URL=http://localhost:5173

# Seed admin account — used by: npm run seed-admin
ADMIN_NAME=OnlineKirana Admin
ADMIN_EMAIL=admin@onlinekirana.com
ADMIN_PASSWORD=ChangeMe@123