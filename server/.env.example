# ─────────────────────────────────────────────────────────────
# OnlineKirana — server environment (EXAMPLE)
#
# Copy this file to `.env` and fill in your own values:
#     cp server/.env.example server/.env
# The real `server/.env` is gitignored and must NEVER be committed.
#
# These are read on the SERVER, at runtime. No `VITE_` prefix — those are only
# exposed to the browser by Vite and are meaningless here.
#
# On Render/Railway: set these under the service's Environment tab.
# ─────────────────────────────────────────────────────────────

# Port the Express API listens on.
#   Local:  5000
#   Render: leave this OUT and let the platform inject its own PORT, or set 5000.
PORT=5000

# MongoDB connection string.
#   Local Atlas-free / mongod:
#     mongodb://127.0.0.1:27017/onlinekirana
#   MongoDB Atlas (required in production — Render/Railway cannot reach your
#   local mongod). Use the SRV string from Atlas → Connect → Drivers:
#     mongodb+srv://<user>:<password>@<cluster-host>/onlinekirana?retryWrites=true&w=majority
# In Atlas, add your server's IP to the access list (0.0.0.0/0 for a public API).
MONGO_URI=mongodb://127.0.0.1:27017/onlinekirana

# Secret used to sign/verify JWTs. MUST be replaced in production — anyone with
# this can mint tokens for any account, including admin.
#   Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a different value here than in local dev, so a leaked dev token cannot be
# replayed against production.
JWT_SECRET=replace-with-a-long-random-string

# Allowed CORS origin(s) — comma-separated, no spaces, NO trailing slash.
#
# This is a strict allowlist: any Origin not listed is rejected, so browsers
# block the request. It must contain EVERY frontend that talks to this API.
#
#   Local (both apps, both ports):
#     http://localhost:5173,http://localhost:5174
#   Production — list BOTH deployed frontends, then REDEPLOY the server:
#     https://<storefront-domain>,https://<partners-domain>
#
# Forgetting the partners URL is the classic first-deploy failure: the storefront
# works while every portal request is blocked, which looks like an app bug.
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Seed admin account — used by: npm run seed-admin
# Change the password before running it anywhere public.
ADMIN_NAME=OnlineKirana Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@123