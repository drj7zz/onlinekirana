# ─────────────────────────────────────────────────────────────
# OnlineKirana — MongoDB Atlas credentials (EXAMPLE)
# Generated by the Atlas onboarding flow in real setups.
# Copy to `atlas-credentials.env` and fill in your own values.
# The real file is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

MONGODB_USERNAME="your-atlas-db-user"
MONGODB_PASSWORD="your-atlas-db-password"
MONGODB_URI="mongodb+srv://your-atlas-db-user:your-atlas-db-password@your-cluster.mongodb.net"